# WireJac host workspace. This directory contains immutable run artifacts.
WIREJAC_WORKSPACE_ROOT=${HOME}/.wirejac/runs

# Pinned MicroPython ESP32_GENERIC v1.28.0 image used for simulation and
# authorized provisioning. The service verifies this SHA-256 before use.
WIREJAC_MICROPYTHON_FIRMWARE=${HOME}/.wirejac/firmware/ESP32_GENERIC-20260406-v1.28.0.bin
WIREJAC_MICROPYTHON_SHA256=cd7820d02c35d34dd403b44263129c6a511b350aea8446c229890753fe240784

# Optional headless Wokwi simulation. Leave unset for plan-only use.
WOKWI_CLI_TOKEN=

# Optional override for the API JWT signing secret. scripts/start-local.sh
# otherwise creates and reuses a mode-0600 value under ~/.wirejac.
# WIREJAC_JWT_SECRET=
# WIREJAC_JWT_SECRET_FILE=${HOME}/.wirejac/jwt-secret

# Optional Jac byLLM provider settings for WIREJAC_GENERATION=llm.
# BYLLM_DEFAULT_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Local demo defaults.
WIREJAC_EXECUTION_MODE=plan
WIREJAC_GENERATION=fixture
WIREJAC_ALLOW_PROVISION=0

# Physical deployment requires the stable by-id path and should pin the MAC.
# WIREJAC_DEVICE=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
# WIREJAC_EXPECTED_MAC=8c:aa:b5:8b:44:5c
