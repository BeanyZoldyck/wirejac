# Credentials -- never commit. AWS credentials are resolved from the local AWS
# config or the process environment, never from this repository.
*.pem
*.key
credentials
credentials.json
aws-credentials*
jac.local.toml
.env
.env.*
!.env.example

# Jac build cache and artifacts
orchestrator/.jac/cache
.jac
.jac/
__jac_gen__/
*.jab

# Hardware-agent local artifacts and firmware images.
.wirejac/
artifacts/
runs/
*.bin
*.log

# Pipeline runtime artifacts. Keep the directory structure via .gitkeep.
runtime/events/*
!runtime/events/.gitkeep
runtime/snapshots/*
!runtime/snapshots/.gitkeep
runtime/logs/

# Python / pytest
__pycache__/
*.py[cod]
.pytest_cache/

# Node / CDK
node_modules/
cdk.out/
*.tsbuildinfo

# Editor and OS
.DS_Store
*.swp

# Local docs not part of the repo
JacHacks_SF_Hacker_Guide.pdf
